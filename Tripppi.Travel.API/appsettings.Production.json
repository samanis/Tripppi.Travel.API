{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=${DB_HOST};Port=5432;Database=${DB_NAME};Username=${DB_USER};Password=${DB_PASSWORD};SSL Mode=Require;Trust Server Certificate=true;Options='-c default_transaction_read_only=on'"
  },
  "Cache": {
    "AirportsKey": "AirportsCache",
    "AirportsTtlSeconds": 86400
  },
  "Security": {
    "OriginSecret": "${ORIGIN_SECRET}",
    "AllowedOrigin": "https://tripppi.com"
  }
}
