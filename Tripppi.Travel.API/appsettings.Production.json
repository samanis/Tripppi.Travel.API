{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "AWS": {
      "LogGroup": "/aws/ec2/airpath-api",
      "Region": "ca-central-1"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Cache": {
    "AirportsKey": "AirportsCache",
    "AirportsTtlSeconds": 86400
  },
  "Security": {
    "OriginSecret": "",
    "AllowedOrigin": "https://airpath.travel"
  },
  "HealthChecks": {
    "Enabled": true
  }
}
